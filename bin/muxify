#!/bin/sh
# Muxify command line tool.
#
#   muxify browser open [--window <id>] <url>...
#
# Opens each URL as a Tab in the Browser of the tmux Window this runs in. It
# targets $TMUX_PANE, not the session's current Window, so callers without a
# tty (agents, background jobs) still hit their own Window. Muxify picks the
# request up from the Window's @muxify_open option within a second (ADR 0003).
set -eu

usage() {
    cat >&2 <<'EOF'
usage: muxify browser open [--window <id>] <url>...

Opens each URL as a Tab in this tmux Window's Browser.
  --window <id>   open in another Window instead, e.g. --window @12
EOF
    exit "${1:-2}"
}

die() {
    echo "muxify: $*" >&2
    exit 1
}

browser_open() {
    target=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -w|--window)
                [ $# -ge 2 ] || usage
                target="$2"
                shift 2
                ;;
            --window=*)
                target="${1#--window=}"
                shift
                ;;
            -h|--help) usage 0 ;;
            --) shift; break ;;
            -*) die "unknown option $1" ;;
            *) break ;;
        esac
    done
    [ $# -gt 0 ] || usage

    if [ -z "$target" ]; then
        [ -n "${TMUX_PANE:-}" ] || die "not inside tmux; specify the Window with --window <id> (e.g. --window @12)"
        target="$TMUX_PANE"
    fi

    urls=""
    for url in "$@"; do
        case "$url" in
            *[[:space:]]*) die "'$url' contains spaces; pass one URL per argument" ;;
        esac
        urls="$urls $url"
    done

    # Not display-message: it exits 0 for a target that doesn't exist.
    window=$(tmux list-panes -t "$target" -F '#{window_id}' 2>/dev/null | head -n 1)
    [ -n "$window" ] || die "no tmux Window '$target'"
    # Append, so requests made before Muxify's next poll aren't overwritten.
    tmux set-option -wa -t "$window" @muxify_open "$urls"
}

case "${1:-}" in
    browser)
        shift
        case "${1:-}" in
            open) shift; browser_open "$@" ;;
            -h|--help) usage 0 ;;
            *) usage ;;
        esac
        ;;
    -h|--help|help) usage 0 ;;
    *) usage ;;
esac
